# Public AdSense configuration. Copy these entries into .env.local or your host.
# Rebuild/redeploy after changing NEXT_PUBLIC_ values.
# off = hidden, preview = labelled mockup (no Google requests), live = real ads.
# Default when unset: preview in next dev; off in production.
NEXT_PUBLIC_ADSENSE_MODE=preview

# Verified publisher. Website monetization still needs activation and review.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7552640548182350
# Paste data-ad-slot from an AdSense display ad unit once available.
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
