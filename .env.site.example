# Public information only. Leave blank until the owner supplies real details.
# Add to your local/deployment environment, then restart/rebuild the app.
SITE_OPERATOR_NAME=
SITE_CONTACT_EMAIL=
# Privacy, terms, cookies and privacy-rights remain drafts and noindex until reviewed.
# Filling these values alone does not finalise policies or implement request handling.

# Public address of the site, with https:// and no path. Used for canonical URLs, hreflang links and the
# sitemap. On Netlify the built-in `URL` variable is used when this is empty; set it once the custom domain
# is final so previews and the production site agree. See docs/MULTILINGUAL-SEO.md.
NEXT_PUBLIC_SITE_URL=
